SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Set this to a Fernet key through your local secret file or deployment secret manager.
ENCRYPTION_MASTER_KEY=replace-with-a-fernet-key

# Server-only Auth admin key for trusted invitations; never use a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical, allow-listed invitation landing origin.
FRONTEND_URL=https://chronosync-lovat.vercel.app

# Transactional email: only these two NEW values are required. The service-role
# key above is also required by the durable worker (never expose it to Vite).
# EMAIL_FROM must use your Resend-verified domain hosted in Cloudflare DNS.
RESEND_API_KEY=
EMAIL_FROM=
# Optional existing mailbox, including a Cloudflare Email Routing address.
EMAIL_REPLY_TO=

# Starts automatically when email is configured. Disable in local processes
# connected to the hosted database unless they intentionally own email delivery.
EMAIL_WORKER_ENABLED=true
EMAIL_POLL_SECONDS=15
# auto selects Resend when configured, otherwise existing provider delivery.
# provider keeps invoice delivery at Számlázz.hu; resend explicitly requires setup.
INVOICE_EMAIL_TRANSPORT=auto
